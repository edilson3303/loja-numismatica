{
  "name": "loja-numismatica-secure",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "init-admin": "node --env-file-if-exists=.env scripts/init-admin.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "check": "node --check src/server.mjs && node --check src/security.mjs && node --check src/cloud.mjs && node --check scripts/init-admin.mjs"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "multer": "2.3.0",
    "sharp": "0.35.4",
    "@supabase/supabase-js": "2.112.4",
    "sanitize-html": "2.17.0",
    "pdfkit": "0.17.2"
  }
}
