NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
TRUST_PROXY=1
SESSION_COOKIE_NAME=fmsid
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Supabase > Project Settings > API Keys > Secret keys (recomendado em 2026)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_COLE_AQUI
# Compatibilidade opcional com a chave antiga:
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_ENCRYPTION_KEY=COLOQUE_UMA_CHAVE_BASE64URL_DE_32_BYTES

# Token de uso único para /setup. Gere com o mesmo comando de APP_ENCRYPTION_KEY.
SETUP_TOKEN=COLOQUE_UM_TOKEN_ALEATORIO_FORTE
WHATSAPP_NUMBER=5596999999999

# ---- Multi-lojas ----
# Domínio da plataforma (opcional até você comprar um). Com ele, cada loja fica em
# <endereco>.PLATFORM_DOMAIN e o painel em painel.PLATFORM_DOMAIN/plataforma.
# PLATFORM_DOMAIN=suaplataforma.com.br
# Hosts onde o painel /plataforma funciona (padrão: host de BASE_URL).
# PLATFORM_HOSTS=lojanumismaticamcp.onrender.com
# Hosts que abrem a loja principal (padrão: host de BASE_URL).
# DEFAULT_STORE_HOSTS=lojanumismaticamcp.onrender.com
# Token do primeiro acesso a /plataforma/entrar (padrão: SETUP_TOKEN).
# PLATFORM_SETUP_TOKEN=
